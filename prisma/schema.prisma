// Schéma Prisma — Académie Conseils
// Postgres (Neon via Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
//   Utilisateurs
// ============================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  firstName String
  lastName  String
  phone     String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies     Company[]
  formalities   Formality[]
  orders        Order[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// ============================================
//   Sociétés du client (immatriculées)
// ============================================
model Company {
  id           String      @id @default(cuid())
  name         String
  type         CompanyType @default(SARL)
  siren        String?     @unique
  rcsVille     String?
  capital      Int
  address      String
  postalCode   String
  city         String
  purpose      String
  duration     Int         @default(99)
  fiscalYear   String      @default("31/12")

  shareholders Json
  manager      String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  formalities  Formality[]

  @@map("companies")
}

// ============================================
//   Formalités (création / modif / cession / dissolution)
// ============================================
model Formality {
  id          String           @id @default(cuid())
  category    FormalityCategory
  type        String           // SARL, SAS, transfert-siege, parts, anticipee, etc.
  status      FormalityStatus  @default(PENDING_PAYMENT)
  price       Int              // en euros

  // Données du formulaire (snapshot complet)
  data        Json

  // Référence Stripe
  stripeSessionId  String?  @unique
  stripePaymentId  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  paidAt      DateTime?
  completedAt DateTime?

  // Relations
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  orders      Order[]

  @@map("formalities")
  @@index([userId])
  @@index([status])
  @@index([category])
}

// ============================================
//   Commandes / paiements
// ============================================
model Order {
  id           String      @id @default(cuid())
  amount       Int         // en centimes
  currency     String      @default("eur")
  status       OrderStatus @default(PENDING)
  stripeId     String?     @unique
  paidAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  formalityId  String
  formality    Formality   @relation(fields: [formalityId], references: [id], onDelete: Cascade)

  @@map("orders")
}

// ============================================
//   Énumérations
// ============================================
enum CompanyType {
  SARL
  SAS
  SASU
  EURL
  SCI
  SA
  AE
  ASSOC
}

enum FormalityCategory {
  creation
  modification
  cession
  dissolution
}

enum FormalityStatus {
  PENDING_PAYMENT
  PAID
  IN_REVIEW
  DOCUMENTS_GENERATED
  FILED_TO_REGISTRY
  COMPLETED
  CANCELLED
  FAILED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

